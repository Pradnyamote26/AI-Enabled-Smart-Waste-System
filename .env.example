# ==========================================
# AI-Enabled Smart Waste System Configuration
# ==========================================

# Server & Mode
FLASK_SECRET_KEY=smart-waste-dev-secret-key-3912048
APP_ENV=development
PORT=5000
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend Web Origin
PUBLIC_WEB_BASE_URL=http://localhost:5173

# Supabase Credentials (optional for cloud PostgreSQL, local store active by default)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Cloudinary Storage (optional for cloud CDN, local file storage active by default)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Routing Engine (OSRM road distance matrix)
OSRM_BASE_URL=https://router.project-osrm.org
